<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight/App Store upload straight from xcodebuild: method
	     app-store-connect with destination upload sends the build to App
	     Store Connect without an .ipa ever landing on disk. Signing is
	     minted headlessly by the ASC API key passed on the command line
	     (see .env.signing) — there is no Apple ID in Xcode on this machine. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>6Q9BX97LMS</string>
</dict>
</plist>
